# ==============================================================================
# LOSSLESS AUDIO - ROOT GITIGNORE
# ==============================================================================

# --- PlatformIO Build & Dependency Directories ---
# These are generated during building or package restore
**/.pio/
**/.pioenvs/
**/.piolibdeps/
**/.clang_complete
**/.gcc-flags.json

# --- VS Code Configuration ---
# VS Code C/C++ Intellisense and debugging files are dynamically regenerated
# by PlatformIO and are machine-specific.
**/.vscode/.browse.c_cpp.db*
**/.vscode/c_cpp_properties.json
**/.vscode/launch.json
**/.vscode/ipch/

# --- Compilation and Build Outputs ---
# Backup in case some raw compiler tools are run manually
*.o
*.a
*.elf
*.bin
*.hex
*.d

# --- Operating System Files ---
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# Linux
*~

# --- Temp & Editor Files ---
*.swp
*.swo
*.bak
*.tmp
*.log
